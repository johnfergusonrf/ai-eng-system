{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "types": ["bun-types"],
        "noImplicitAny": false,
        "strictNullChecks": false,
        "paths": {
            "@ai-eng-system/core": ["../core/src/index.ts"],
            "@ai-eng-system/core/content": ["../core/src/content-loader.ts"],
            "@ai-eng-system/core/paths": ["../core/src/paths.ts"]
        }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
